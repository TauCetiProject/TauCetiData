{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tauceti.resolution/v1",
  "title": "Judge-panel resolution",
  "description": "The outcome of applying a named resolution policy to a pair's judgments. Explicit events (not derived on the fly) so a later policy change cannot silently re-label history. Idempotency key: (pair_id, policy).",
  "type": "object",
  "required": ["schema", "pair_id", "status", "policy"],
  "properties": {
    "schema": {"const": "tauceti.resolution/v1"},
    "pair_id": {"type": "string"},
    "status": {"enum": ["ai_decided", "undecided"]},
    "consensus": {"enum": ["a", "b", "tie", null]},
    "policy": {"type": "string"},
    "judgment_ids": {"type": "array", "items": {"type": "string"}},
    "reason": {"type": ["string", "null"]},
    "ts": {"type": ["string", "null"], "format": "date-time"}
  }
}
